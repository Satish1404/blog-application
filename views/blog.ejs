<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title> blog blog</title>
</head>
<body>

<%- include('./partials/nav') %>

<div class="blog-container">

    <article class="blog-post">

        <h1 class="blog-title">
            <%= blogs.title %>
        </h1>

        <div class="blog-meta">
            <span>By <%= blogs.createdBy?.fullName || "Anonymous" %></span>
            <span>•</span>
            <span>
            <%= new Date(blogs.createdAt).toLocaleString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: 'numeric',
                minute: '2-digit'
            }) %>
        </span>
        <% if (locals.user) { %>
            <a href="/blog/<%= blogs._id %>/edit" class="btn btn-outline-primary rounded-pill">
                ✏️Edit
            </a>
            <form action="/blog/<%= blogs._id %>?_method=DELETE" method="POST">
               <button type="submit" class="btn btn-outline-danger rounded-pill ">Delete</button>
            </form>
        <% } %>

        </div>

    <% if (blogs.tags && blogs.tags.length > 0) { %>

    <div class="mt-3">

        <% blogs.tags.forEach(tag => { %>

            <span class="badge bg-secondary me-1">
                #<%= tag %>
            </span>

        <% }) %>

    </div>

<% } %>


        <img
            src="<%= blogs.coverImageURL %>"
            class="blog-cover"
            alt="<%= blogs.title %>"
        />

        <div class="blog-content">
            <p><%= blogs.body %></p>
        </div>

    </article>
    
    <% if (locals.user) { %>
        <div class="conatiner">
         <form action="/blog/<%= blogs._id %>/like" method="POST">
            <img
                    src="<%= user.profileImageURL %>"
                    class="profileImage"
                    alt="profileImageURL"
            />
                <%= blogs.createdBy?.fullName  %>


            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <button class="like-btn me-md-2" type="submit">
                    <% if (isLiked) { %>

                        ❤️ Liked <%= blogs.likes.length %>

                    <% } else { %>

                        🤍 Like <%= blogs.likes.length %>

                    <% } %>
            </button>
            
            </div>

        </form>
                
        </div>
    <% } %>



    <div class="comments-section mt-3">

       
             <h2>Comments (<%= comments.length %>)</h2>

       

        <% if (locals.user) { %>

        <form action="/blog/comment/<%= blogs._id %>" method="POST">

            <textarea
                name="content"
                class="form-control"
                placeholder="Write your comment..."
                rows="4"
                required
            ></textarea>

            <button type="submit" class="btn btn-primary mt-3">
                Post Comment
            </button>

        </form>
         
        <% } %>
    </div>



  <% comments.forEach(comment => { %>
   <div class="conatiner mt-3">
      <img
            src="<%= comment.createdBy.profileImageURL %>"
            class="profileImage"
            alt="profileImageURL"
        />
        <%= comment.createdBy.fullName %>
        <pre><%= comment.content%></pre>
        
   </div>
  <% }) %>


</div>
   
<%- include('./partials/scripts') %>
</body>
</html>