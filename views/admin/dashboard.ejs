<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1>Admin Dashboard</h1>

    <p>
        Welcome, <%= user.fullName %>
    </p>

    <hr>

    <div class="row">

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total Users</h5>
               <h2><%= totalUsers %></h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total Blogs</h5>
                <h2><%= totalBlogs %></h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total Comments</h5>
                <h2><%= totalComments %></h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Categories</h5>
                <h2><%= totalCategories %></h2>
            </div>
        </div>

    </div>

</div>

</body>
</html>